rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hasnainbuilds724656@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && (resource.data.email == request.auth.token.email || resource.data.uid == request.auth.uid))
      );
    }

    // Default Deny Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostics / Health Check Probes
    match /_health_checks/{document=**} {
      allow read, write: if isSignedIn();
    }

    // 1. Role Assignments & CR/Teacher Bindings
    match /crAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teacherAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    match /subjectTeacherAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    match /subjectInvitations/{invitationId} {
      allow read, write: if isSignedIn();
    }

    match /roleAssignments/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write, create, update: if isSignedIn();
    }

    // 3. Attendance Sessions
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 4. Student Assignment Submissions
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // 5. Security Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 6. University Branding & Portal Configuration
    match /config/branding {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branding/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Academic Content & Schedules
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /scheduleDrafts/{draftId} {
      allow read, write: if isSignedIn();
    }

    match /scheduleOverrides/{overrideId} {
      allow read, write: if isSignedIn();
    }

    match /scheduleHistory/{historyId} {
      allow read, write: if isSignedIn();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    // 8. User Verification Aggregates & Historical Backup Archives
    match /aggregates/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users_backup_archive/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
