rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hasnainbuilds724656@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && (resource.data.email == request.auth.token.email || resource.data.uid == request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper checking active CR assignment for a target class
    function isCRForClass(targetClass) {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/crAssignments/$( 'cr_' + request.auth.token.email.replace('[@.]', '_') )) &&
          get(/databases/$(database)/documents/crAssignments/$( 'cr_' + request.auth.token.email.replace('[@.]', '_') )).data.status == 'active' &&
          (
            targetClass == null || targetClass == '' ||
            get(/databases/$(database)/documents/crAssignments/$( 'cr_' + request.auth.token.email.replace('[@.]', '_') )).data.assignedClass.lower() == targetClass.lower()
          )
        )
      );
    }

    // Helper checking active Teacher assignment
    function isTeacher() {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/teacherAssignments/$( 'teacher_' + request.auth.token.email.replace('[@.]', '_') )) &&
          get(/databases/$(database)/documents/teacherAssignments/$( 'teacher_' + request.auth.token.email.replace('[@.]', '_') )).data.status == 'active'
        )
      );
    }

    // Default Deny Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostics / Health Check Probes
    match /_health_checks/{document=**} {
      allow read, write: if isSignedIn();
    }

    // 1. Role Assignments & CR Bindings (Strictly Master Admin Controlled)
    match /crAssignments/{assignmentId} {
      // Students can only read their own CR assignment; Master Admin can read all
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      // ONLY Master Admin can grant, modify, or revoke CR assignments
      allow write: if isAdmin();
    }

    match /teacherAssignments/{assignmentId} {
      // Teachers can read their own assignment; Master Admin can read all
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      // ONLY Master Admin can grant, modify, or revoke Teacher assignments
      allow write: if isAdmin();
    }

    match /subjectTeacherAssignments/{assignmentId} {
      allow read: if isSignedIn();
      // ONLY Master Admin can assign, replace, or revoke subject teachers
      allow write: if isAdmin();
    }

    match /subjectInvitations/{invitationId} {
      // Only Master Admin can read/write invitation records directly via client SDK
      // Client verification and claiming is handled by privileged server API with SHA-256 hash checks
      allow read, write: if isAdmin();
    }

    match /roleAssignments/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      // Master Admin can write any user profile
      allow write: if isAdmin();
      // Authenticated users can create their initial user profile during registration (students or subject teachers)
      allow create: if isSignedIn() && (
        (
          request.resource.data.role == 'student' &&
          (!('isCR' in request.resource.data) || request.resource.data.isCR == false) &&
          (!('crStatus' in request.resource.data) || request.resource.data.crStatus == 'none') &&
          (!('teacherStatus' in request.resource.data) || request.resource.data.teacherStatus == 'none')
        ) || (
          request.resource.data.role == 'teacher'
        )
      );
      // Normal users can update non-privileged fields on their own profile
      allow update: if isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'roles', 'isCR', 'crStatus', 'teacherStatus', 'assignedClass', 'assignedSubjects'])
      );
    }

    // 3. Attendance Sessions (Restricted to Authorized CRs for assigned class or Master Admin)
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn();
      // Write permitted ONLY to Master Admin or authorized active CR for that section
      allow create: if isAdmin() || (
        isSignedIn() &&
        isCRForClass(incoming().classId)
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        isCRForClass(existing().classId) &&
        // Non-admin CRs cannot un-finalize or tamper with finalized sheets
        (existing().finalized != true || incoming().finalized == true)
      );
      allow delete: if isAdmin();
    }

    // 4. Student Assignment Submissions
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        resource.data.studentEmail == request.auth.token.email ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        incoming().studentEmail == request.auth.token.email ||
        incoming().studentUid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (existing().studentEmail == request.auth.token.email || existing().studentUid == request.auth.uid) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['fileUrl', 'submittedAt', 'status'])
        ) ||
        isTeacher()
      );
      allow delete: if isAdmin();
    }

    // 5. Security Audit Logs (Append-only by authenticated users, read by Admin)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 6. University Branding & Portal Configuration
    match /config/branding {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branding/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Academic Content & Schedules
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() &&
        isCRForClass(incoming().classId)
      );
    }

    match /scheduleDrafts/{draftId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCRForClass(resource.data.classId)
      );
      allow write: if isAdmin() || (
        isSignedIn() &&
        isCRForClass(incoming().classId)
      );
    }

    match /scheduleOverrides/{overrideId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() &&
        isCRForClass(incoming().classId)
      );
    }

    match /scheduleHistory/{historyId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCRForClass(resource.data.classId)
      );
      allow write: if isAdmin() || (
        isSignedIn() &&
        isCRForClass(incoming().classId)
      );
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 8. User Verification Aggregates & Historical Backup Archives
    match /aggregates/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users_backup_archive/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
